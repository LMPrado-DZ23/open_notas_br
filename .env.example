# =============================================================================
# open_notas_br — variáveis de ambiente
# Copie para `.env` e ajuste. NUNCA versione o `.env`.
#   cp .env.example .env
# =============================================================================

# --- Aplicação ---------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true
API_HOST=0.0.0.0
API_PORT=8080

# --- Portas no host (docker compose) -----------------------------------------
# Escolhidas fora das padrão porque outros projetos locais usam 5432/6379/8080.
POSTGRES_HOST_PORT=55434
REDIS_HOST_PORT=56379
API_HOST_PORT=8081

# --- Banco de dados ----------------------------------------------------------
# Dentro do compose o host é `postgres`; fora dele use 127.0.0.1:55434.
# A porta do host é configurável em POSTGRES_HOST_PORT (padrão 55434),
# para não colidir com outro PostgreSQL local.
DATABASE_URL=postgresql+asyncpg://notasbr:notasbr@postgres:5432/notasbr
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Redis (fila ARQ + cache) ------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Chave-mestra do cofre de certificados -----------------------------------
# 32 bytes em base64. Gere a sua:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
#
# NUNCA versione este valor. Perder a chave significa perder todos os
# certificados A1 selados com ela — não há recuperação.
#
# Deixe VAZIO apenas em desenvolvimento: a aplicação gera uma chave efêmera em
# memória e avisa no log. Certificados selados com chave efêmera ficam
# ilegíveis após reiniciar. Em produção (ENVIRONMENT=production) é obrigatório.
MASTER_ENCRYPTION_KEY=

# --- Token administrativo (bootstrap de tenants) -----------------------------
# Protege POST /v1/tenants. Gere com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Vazio só é aceito em desenvolvimento.
ADMIN_API_TOKEN=

# --- NFS-e Nacional (SEFIN / ADN) — Fase 3 -----------------------------------
# [A VALIDAR] A URL base NÃO foi confirmada em fonte oficial nesta execução.
# O adapter lê daqui; nenhum endpoint é hardcoded no código.
SEFIN_BASE_URL=
SEFIN_HOMOLOGACAO_BASE_URL=
SEFIN_PRODUCAO_BASE_URL=
SEFIN_TIMEOUT_SECONDS=30
# Permitir host que nao seja nfse.gov.br (espelho interno). Desligado por padrao.
SEFIN_PERMITIR_HOST_NAO_OFICIAL=false
# `sefin` = cliente real da SEFIN/ADN (padrao).
# `mock` = duble deterministico: exercita o fluxo completo sem certificado real.
NFSE_ADAPTER=sefin

# --- CNPJ (Serpro) — Fase 3 --------------------------------------------------
# A API Serpro tem cota (30 dias grátis / 3.000 consultas) e cobra depois.
# Sem token, o serviço cai no fallback de dados abertos da RFB.
SERPRO_CNPJ_TOKEN=
SERPRO_CNPJ_BASE_URL=https://gateway.apiserpro.serpro.gov.br/consulta-cnpj-df-v1
CNPJ_CACHE_TTL_SECONDS=86400
CNPJ_RATE_LIMIT_PER_SECOND=5
CNPJ_FALLBACK_ENABLED=true

# --- Reforma Tributária (IBS/CBS) — Fase 3 -----------------------------------
# Alíquotas de referência são DADO versionado por competência, não constante de
# código. Valores iniciais 2026 conforme premissa do briefing.
RTC_CBS_ALIQUOTA_2026=0.009
RTC_IBS_ALIQUOTA_2026=0.001

# --- Webhooks — Fase 5 -------------------------------------------------------
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5

# --- API ---------------------------------------------------------------------
API_PAGE_SIZE_DEFAULT=50
API_PAGE_SIZE_MAX=200

# --- CORS --------------------------------------------------------------------
# Origens permitidas para chamada a partir de navegador, separadas por vírgula.
# Em produção, liste os domínios dos parceiros (ex.: https://dz23.com.br).
# Vazio = navegador não é permitido, o que é o padrão seguro para API server-side.
CORS_ORIGINS=

# -- Frete / etiqueta de envio (Melhor Envio) ---------------------------------
# Credenciais do APLICATIVO, uma por plataforma (não por lojista). O token de cada
# lojista vem por OAuth e é guardado cifrado por tenant.
# Cadastre o app em https://app.melhorenvio.com.br/integracoes/area-dev
# A redirect_uri abaixo precisa ser IDÊNTICA à cadastrada no app.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_REDIRECT_URI=http://127.0.0.1:8081/v1/fretes/oauth/callback
# true = sandbox.melhorenvio.com.br. Produção compra etiqueta de verdade.
MELHOR_ENVIO_SANDBOX=true

# Rate limit por tenant. Desligado por padrão: ligar muda o comportamento de todas as
# rotas. Quem quiser ligar, liga explicitamente.
RATE_LIMIT_HABILITADO=false
RATE_LIMIT_POR_MINUTO=60
